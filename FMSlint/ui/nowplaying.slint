// The test screen: everything a modern Now Playing needs, drawn by Slint over the video.

import "Inter.ttf";

component IconButton {
    in property <string> icon;
    in property <color> tint: white;
    in property <length> icon-size: 28px;
    callback clicked;

    width: 56px;
    height: 56px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        background: touch.pressed ? #ffffff28 : transparent;
        animate background { duration: 120ms; }
    }

    Path {
        width: root.icon-size * (touch.pressed ? 0.86 : 1);
        height: self.width;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: root.tint;
        animate width { duration: 120ms; easing: ease-out; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component NowPlaying inherits Window {
    in property <string> stats: "starting";
    property <bool> playing: true;
    property <bool> liked;
    property <bool> show-lyrics;
    property <float> progress: 0.32;

    background: transparent;
    default-font-family: "Inter";
    default-font-size: 15px;

    Timer {
        interval: 1s;
        running: root.playing && !scrub.pressed;
        triggered => { root.progress = Math.mod(root.progress + 0.005, 1); }
    }

    // Fades the video into the controls.
    Rectangle {
        background: @linear-gradient(180deg, #00000066 0%, #00000000 18%, #00000000 42%, #000000d8 76%, #000000f4 100%);
    }

    Text {
        x: 16px;
        y: 12px;
        text: root.stats;
        color: #ffffffb0;
        font-size: 12px;
    }

    // Moves all the time, so the frame rate shown is the real one.
    HorizontalLayout {
        x: root.width - 52px;
        y: 12px;
        width: 36px;
        height: 16px;
        spacing: 3px;
        for bar in 5: Rectangle {
            property <float> wave: 0.5 + 0.5 * sin(animation-tick() / 240ms * 1rad + bar * 1.1rad);
            y: parent.height - self.height;
            height: root.playing ? parent.height * (0.2 + 0.8 * wave) : 3px;
            background: #1ed760;
            border-radius: 1.5px;
        }
    }

    VerticalLayout {
        y: root.height - self.height;
        height: 260px;
        padding-left: 20px;
        padding-right: 20px;
        padding-bottom: 18px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            alignment: stretch;

            cover := Rectangle {
                width: 54px;
                height: 54px;
                border-radius: 8px;
                background: @linear-gradient(135deg, #ff5f6d 0%, #8a3ffc 100%);
                drop-shadow-blur: 14px;
                drop-shadow-color: #000000a0;
                drop-shadow-offset-y: 4px;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: "A Very Modern Song";
                    color: white;
                    font-size: 19px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: "Retrofy on iOS 6";
                    color: #ffffffb8;
                }
            }

            IconButton {
                width: 44px;
                height: 54px;
                icon: "M12 21 C5 15 2 12 2 8 C2 5 4.5 3 7 3 C9 3 11 4 12 6 C13 4 15 3 17 3 C19.5 3 22 5 22 8 C22 12 19 15 12 21 Z";
                tint: root.liked ? #1ed760 : #ffffff90;
                clicked => { root.liked = !root.liked; }
            }
        }

        // Seek bar, follows the finger.
        Rectangle {
            height: 34px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                height: scrub.pressed ? 6px : 4px;
                border-radius: self.height / 2;
                background: #ffffff38;
                animate height { duration: 120ms; }
            }
            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width * root.progress;
                height: scrub.pressed ? 6px : 4px;
                border-radius: self.height / 2;
                background: #ffffff;
            }
            Rectangle {
                x: parent.width * root.progress - self.width / 2;
                y: (parent.height - self.height) / 2;
                width: scrub.pressed ? 18px : 12px;
                height: self.width;
                border-radius: self.width / 2;
                background: white;
                drop-shadow-blur: 6px;
                drop-shadow-color: #00000080;
                animate width { duration: 120ms; easing: ease-out; }
            }

            scrub := TouchArea {
                moved => { root.progress = clamp(self.mouse-x / self.width, 0, 1); }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.progress = clamp(self.mouse-x / self.width, 0, 1);
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: space-between;

            IconButton {
                icon: "M3 7 H7 C11 7 13 17 17 17 H21 M3 17 H7 C8.5 17 9.5 15.5 10.5 14 M13.5 10 C14.5 8.5 15.5 7 17 7 H21";
                icon-size: 24px;
                tint: #ffffffb0;
            }
            IconButton { icon: "M6 5 H8 V19 H6 Z M20 5 V19 L9 12 Z"; }

            Rectangle {
                width: 66px;
                height: 66px;
                border-radius: self.width / 2;
                background: play.pressed ? #dddddd : white;
                drop-shadow-blur: 18px;
                drop-shadow-color: #00000090;
                drop-shadow-offset-y: 5px;
                animate background { duration: 120ms; }

                Path {
                    width: 30px;
                    height: 30px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    fill: black;
                    commands: root.playing ? "M6 4 H10 V20 H6 Z M14 4 H18 V20 H14 Z" : "M7 4 V20 L20 12 Z";
                }
                play := TouchArea {
                    clicked => { root.playing = !root.playing; }
                }
            }

            IconButton { icon: "M18 5 H16 V19 H18 Z M4 5 V19 L15 12 Z"; }
            IconButton {
                icon: "M4 6 H20 V8 H4 Z M4 11 H20 V13 H4 Z M4 16 H14 V18 H4 Z";
                icon-size: 24px;
                tint: root.show-lyrics ? #1ed760 : #ffffffb0;
                clicked => { root.show-lyrics = !root.show-lyrics; }
            }
        }
    }

    // A scrolling sheet over everything, with a blurred shadow.
    Rectangle {
        y: root.show-lyrics ? 90px : root.height + 40px;
        height: root.height - 90px;
        border-top-left-radius: 22px;
        border-top-right-radius: 22px;
        background: #1a1a1fec;
        drop-shadow-blur: 30px;
        drop-shadow-color: #000000b0;
        animate y { duration: 340ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1); }

        Rectangle {
            y: 8px;
            width: 40px;
            height: 4px;
            border-radius: 2px;
            background: #ffffff50;
        }

        TouchArea {
            y: 0;
            height: 34px;
            clicked => { root.show-lyrics = false; }
        }

        Flickable {
            y: 34px;
            height: parent.height - 34px;
            content-height: 44px * 30 + 20px;

            for line in 30: Text {
                x: 22px;
                y: 44px * line;
                width: root.width - 44px;
                height: 44px;
                vertical-alignment: center;
                text: "Scrolling line number " + (line + 1);
                color: mod(line, 4) == 1 ? white : #ffffff70;
                font-size: 22px;
                font-weight: 700;
            }
        }
    }
}
